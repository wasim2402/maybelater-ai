# Copy values into frontend/.env.local (NEXT_PUBLIC_* only) and backend/.env (everything else).
# Never commit real .env files.

# Web (frontend/.env.local) — browser-safe values only
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only, frontend/.env.local (Better Auth). Must equal AUTH_SECRET below.
BETTER_# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# API (backend/.env)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://maybelater:CHANGE_ME@localhost:5432/maybelater
TEST_DATABASE_URL=postgresql+asyncpg://maybelater:CHANGE_ME@localhost:5432/maybelater_test
OPENAI_API_KEY=
OPENAI_MODEL=
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Optional background jobs
REDIS_URL=redis://localhost:6379/0
