# Copy values into frontend/.env.local (NEXT_PUBLIC_* only) and backend/.env (everything else).
# Never commit real .env files.

# Web (frontend/.env.local) — browser-safe values only
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only, frontend/.env.local (Better Auth). Never NEXT_PUBLIC_.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Same PostgreSQL as the API, plain postgresql:// URL; Better Auth's tables live in the "auth" schema.
# Create them with: npm run auth:migrate
AUTH_DATABASE_URL=postgresql://maybelater:CHANGE_ME@localhost:5432/maybelater
# Optional: how the web server reaches the API (defaults to NEXT_PUBLIC_API_URL). Used for account deletion.
# API_INTERNAL_URL=http://localhost:8000

# API (backend/.env)
APP_ENV=development
LOG_LEVEL=INFO
# auto = readable coloured lines in development, JSON lines elsewhere. Or force: pretty | json
LOG_FORMAT=auto
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://maybelater:CHANGE_ME@localhost:5432/maybelater
TEST_DATABASE_URL=postgresql+asyncpg://maybelater:CHANGE_ME@localhost:5432/maybelater_test
# AI suggestions via Google Gemini (optional). Leave the key empty to run without them:
# capture still works, items show "off". Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Takes over when the main model is overloaded, times out or is out of quota (empty = off).
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# GEMINI_MAIN_TIMEOUT_SECONDS=15
# AI_TIMEOUT_SECONDS=30
# Session verification: the API checks Better Auth's EdDSA tokens with its public keys (no shared secret).
AUTH_BASE_URL=http://localhost:3000
# Defaults to {AUTH_BASE_URL}/api/auth/jwks
# AUTH_JWKS_URL=
AUTH_AUDIENCE=maybelater-api
# Known web origins only (JSON list or comma-separated); "*" is rejected.
CORS_ORIGINS=["http://localhost:3000"]
# Largest request body the API accepts, in bytes.
MAX_REQUEST_BYTES=1000000

# Optional background jobs
REDIS_URL=redis://localhost:6379/0
